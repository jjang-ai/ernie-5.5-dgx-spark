+        UVM_ASSERT(slot < UVM_PT_SUBPAGE_SLOTS);
+        slab->used_mask |= (1UL << slot);
+        if (slab->used_mask == UVM_PT_SUBPAGE_FULL_MASK)
+            list_move(&slab->node, &tree->pt_subpage_pool.full_slabs);
+    }
+    spin_unlock(&tree->pt_subpage_pool.lock);
+
+    if (slab != NULL) {
+        void *kaddr = kmap(slab->page);
+        memset((char *)kaddr + ((size_t)slot * UVM_PT_SUBPAGE_SIZE), 0, UVM_PT_SUBPAGE_SIZE);
+        wmb();
+        kunmap(slab->page);
+
+        out->handle.page = slab->page;
+        out->addr = uvm_gpu_phys_address(UVM_APERTURE_SYS,
+                                         slab->dma_addr + ((NvU64)slot * UVM_PT_SUBPAGE_SIZE));
+        out->size = size;
+        out->subpage_slab = slab;
+        out->subpage_slot = slot;
+
+        cur_slots = atomic64_inc_return(&g_uvm_pt_subpage_active_slots);
+        uvm_pt_subpage_update_peak(&g_uvm_pt_subpage_peak_slots, cur_slots);
+        atomic64_inc(&g_uvm_pt_subpage_reuse_hits);
+        return NV_OK;
