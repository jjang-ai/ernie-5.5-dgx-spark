+        status = uvm_gpu_map_cpu_pages(tree->gpu, slab->page, PAGE_SIZE, &dma_addr);
+        if (status != NV_OK) {
+            __free_pages(slab->page, 0);
+            kfree(slab);
+            return status;
+        }
+        slab->dma_mapped = true;
