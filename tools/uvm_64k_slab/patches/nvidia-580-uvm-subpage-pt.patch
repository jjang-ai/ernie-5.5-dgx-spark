+    out->size = size;
+    out->subpage_slab = slab;
+    out->subpage_slot = 0;
+
+    cur_slabs = atomic64_inc_return(&g_uvm_pt_subpage_active_slabs);
+    uvm_pt_subpage_update_peak(&g_uvm_pt_subpage_peak_slabs, cur_slabs);
+    cur_slots = atomic64_inc_return(&g_uvm_pt_subpage_active_slots);
+    uvm_pt_subpage_update_peak(&g_uvm_pt_subpage_peak_slots, cur_slots);
+    return NV_OK;
+}
